<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ComputerRepairSystem_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComputerRepairSystem_winui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ComputerRepairSystem.winui"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
        x:Name="AppTitleBar"
        Title="ComputerRepairSystem.winui"
        BackRequested="TitleBar_BackRequested"
        IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
        IsPaneToggleButtonVisible="True"
        PaneToggleRequested="TitleBar_PaneToggleRequested">

            <TitleBar.IconSource>
                <ImageIconSource
                ImageSource="Assets/LogoIT13CRS.png" />
            </TitleBar.IconSource>

        </TitleBar>

        <Grid Grid.Row="1">

            <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem
                    x:Name="HomeItem"
                    Content="Home"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="ServiceManagementItem"
                    Content="Service Management"
                    Tag="customers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="RepairManagementItem"
                    Content="Repair Management"
                    Tag="repairs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="BillingItem"
                    Content="Billing"
                    Tag="billing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="UserManagementItem"
                    Content="User Management"
                    Tag="users">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                    <NavigationViewItem Content="About" Tag="about" x:Name="AboutItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA3A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame
                x:Name="NavFrame" />

            </NavigationView>

        </Grid>

    </Grid>
</Window>
