<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ComputerRepairSystem_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComputerRepairSystem_winui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ComputerRepairSystem.winui"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CUSTOM TITLE BAR -->
        <Grid
    x:Name="AppTitleBar"
    Height="48"
    Background="#1D1C28"
    Padding="12,0,150,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- MENU BUTTON -->

            <Button
        Grid.Column="0"
        x:Name="PaneToggleButton"
        Width="40"
        Height="40"
        Padding="0"
        VerticalAlignment="Center"
        Click="TitleBar_PaneToggleRequested">

                <SymbolIcon
            Symbol="GlobalNavigationButton"/>

            </Button>


            <!-- LOGO -->

            <Image
        Grid.Column="1"
        Source="ms-appx:///Assets/LogoIT13CRS.png"
        Width="30"
        Height="30"
        Margin="8,0,8,0"
        VerticalAlignment="Center"
        Stretch="Uniform"/>


            <!-- FIXFLOW -->

            <TextBlock
        Grid.Column="2"
        Text="FIXFLOW"
        VerticalAlignment="Center"
        FontSize="18"
        FontWeight="SemiBold"/>


            <!-- RIGHT SIDE -->

            <StackPanel
        Grid.Column="3"
        Orientation="Horizontal"
        VerticalAlignment="Center"
        Spacing="6">


                <!-- SEARCH -->

                <Button
            x:Name="GlobalSearchButton"
            Width="40"
            Height="40"
            Padding="0"
            ToolTipService.ToolTip="Search"
            Click="GlobalSearchButton_Click">

                    <SymbolIcon
                Symbol="Find"/>

                </Button>


                <!-- NOTIFICATIONS -->

                <Button
            x:Name="NotificationButton"
            Width="40"
            Height="40"
            Padding="0"
            ToolTipService.ToolTip="Notifications"
            Click="NotificationButton_Click">

                    <SymbolIcon
                Symbol="OtherUser"/>

                </Button>


                <!-- PROFILE -->

                <Button
            x:Name="ProfileButton"
            Height="40"
            Padding="8,0"
            ToolTipService.ToolTip="Profile"
            Click="ProfileButton_Click">

                    <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                        <PersonPicture
                    Width="30"
                    Height="30"/>

                        <TextBlock
                    x:Name="UserNameText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="1">

            <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem
                    x:Name="HomeItem"
                    Content="Home"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="ServiceManagementItem"
                    Content="Service Management"
                    Tag="customers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="RepairManagementItem"
                    Content="Repair Management"
                    Tag="repairs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="BillingItem"
                    Content="Billing"
                    Tag="billing">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem
                    x:Name="UserManagementItem"
                    Content="User Management"
                    Tag="users">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Inventory"
                    Tag="inventory"
                    x:Name="InventoryItem">

                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>

                </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame
                x:Name="NavFrame" />

            </NavigationView>

        </Grid>

    </Grid>
</Window>
