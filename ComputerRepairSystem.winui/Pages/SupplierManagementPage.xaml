<Page
    x:Class="ComputerRepairSystem.winui.Pages.SupplierManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Supplier Management"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Manage suppliers that provide parts, supplies, and other inventory items."
                    Opacity="0.7"
                    Margin="0,4,0,0"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Add Supplier"
                Click="AddSupplierButton_Click"
                Padding="16,8"/>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Search supplier..."
                TextChanged="SearchBox_TextChanged"
                Margin="0,0,12,0"/>

            <Button
                Grid.Column="1"
                Content="Refresh"
                Click="RefreshButton_Click"
                Padding="16,8"/>
        </Grid>

        <!-- Supplier List -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Grid
                    Grid.Row="0"
                    Padding="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Supplier" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Contact Person" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Phone" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Email" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" Text="Address" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="7" Text="Action" FontWeight="SemiBold"/>
                </Grid>

                <!-- Supplier Rows -->
                <ListView
                    Grid.Row="1"
                    x:Name="SupplierListView"
                    SelectionMode="None">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding SupplierId}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding SupplierCode}"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SupplierName}"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding ContactPerson}"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Phone}"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding Email}"/>

                                <TextBlock
                                    Grid.Column="6"
                                    Text="{Binding Address}"
                                    TextTrimming="CharacterEllipsis"/>

                                <StackPanel
                                    Grid.Column="7"
                                    Orientation="Horizontal"
                                    Spacing="6">

                                    <Button
                                        Content="Edit"
                                        Click="EditSupplierButton_Click"
                                        Tag="{Binding}"/>

                                    <Button
                                        Content="Delete"
                                        Click="DeleteSupplierButton_Click"
                                        Tag="{Binding}"/>

                                </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>
</Page>