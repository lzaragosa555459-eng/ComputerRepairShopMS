<Page
    x:Class="ComputerRepairSystem_winui.Pages.CustomerManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Customer Management"
            FontSize="28"
            FontWeight="SemiBold"/>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12"
            Margin="0,20,0,16">

            <Button
                Content="+ New Customer"
                Click="NewCustomerButton_Click"/>

            <Button
                Content="Edit"
                Click="EditCustomerButton_Click"/>

            <Button
                Content="Delete"
                Click="DeleteCustomerButton_Click"/>

            <TextBox
                x:Name="SearchBox"
                Width="250"
                PlaceholderText="Search customer..."
                TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <ListView
            x:Name="CustomerList"
            Grid.Row="2"
            SelectionChanged="CustomerList_SelectionChanged">

            <ListView.Header>
                <Grid Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name"/>
                    <TextBlock Grid.Column="1" Text="Phone"/>
                    <TextBlock Grid.Column="2" Text="Email"/>
                    <TextBlock Grid.Column="3" Text="Address"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock>
                            <Run Text="{Binding FirstName}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding LastName}"/>
                        </TextBlock>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Phone}"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding Email}"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding Address}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</Page>