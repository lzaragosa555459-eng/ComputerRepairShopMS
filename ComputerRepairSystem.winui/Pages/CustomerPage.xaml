<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Spacing="6">

                <TextBlock
                    Text="Customer Management"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Manage customer information"
                    Opacity="0.7"/>

            </StackPanel>

            <!-- Form -->
            <Grid Grid.Row="1"
                  Margin="0,24,0,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- First Name -->
                <TextBox
                    x:Name="FirstNameBox"
                    Grid.Row="0"
                    Grid.Column="0"
                    Header="First Name"
                    Margin="0,0,12,12"/>

                <!-- Middle Name -->
                <TextBox
                    x:Name="MiddleNameBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Header="Middle Name"
                    Margin="12,0,0,12"/>

                <!-- Last Name -->
                <TextBox
                    x:Name="LastNameBox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Header="Last Name"
                    Margin="0,0,12,12"/>

                <!-- Phone -->
                <TextBox
                    x:Name="PhoneBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Header="Phone"
                    Margin="12,0,0,12"/>

                <!-- Email -->
                <TextBox
                    x:Name="EmailBox"
                    Grid.Row="2"
                    Grid.Column="0"
                    Header="Email"
                    Margin="0,0,12,12"/>

                <!-- Address -->
                <TextBox
                    x:Name="AddressBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    Header="Address"
                    Margin="12,0,0,12"/>

                <!-- Buttons -->
                <StackPanel
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,10,0,0">

                    <Button
                        x:Name="AddButton"
                        Content="Add"
                        Click="AddButton_Click"/>

                    <Button
                        x:Name="UpdateButton"
                        Content="Update"
                        Click="UpdateButton_Click"/>

                    <Button
                        x:Name="DeleteButton"
                        Content="Delete"
                        Click="DeleteButton_Click"/>

                    <Button
                        x:Name="ClearButton"
                        Content="Clear"
                        Click="ClearButton_Click"/>
                </StackPanel>

                <!-- Status -->
                <InfoBar
                    x:Name="StatusBar"
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,16,0,0"
                    IsOpen="False"/>

            </Grid>

            <!-- Customer List -->
            <Border
                Grid.Row="2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

                <ListView
                    x:Name="CustomerList"
                    SelectionChanged="CustomerList_SelectionChanged">

                    <ListView.Header>
                        <Grid Padding="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="ID"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="First Name"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Last Name"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Phone"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="Email"
                                FontWeight="SemiBold"/>

                        </Grid>
                    </ListView.Header>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding CustomerId}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding FirstName}"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding LastName}"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Phone}"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Email}"/>

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </Border>

        </Grid>
    </ScrollViewer>

</Page>