<Page
    x:Class="ComputerRepairSystem_winui.Pages.SubscriptionManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- PAGE HEADER -->
        <!-- ========================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Subscription Management"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage subscription plans, included modules, and company subscriptions."
                Margin="0,6,0,0"
                Opacity="0.7"/>

        </StackPanel>


        <!-- ========================================== -->
        <!-- MAIN CONTENT -->
        <!-- ========================================== -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>


            <!-- ====================================== -->
            <!-- LEFT: SUBSCRIPTION PLANS -->
            <!-- ====================================== -->

            <Border
                Grid.Column="0"
                Padding="20"
                Margin="0,0,12,0"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- PLANS HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Subscription Plans"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <Button
                            Grid.Column="1"
                            Content="Add Plan"
                            Click="AddPlanButton_Click"/>

                    </Grid>


                    <!-- PLANS -->

                    <ListView
                        x:Name="PlansListView"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="PlansListView_SelectionChanged">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Grid Padding="8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding PlanName}"
                                            FontWeight="SemiBold"
                                            FontSize="16"/>

                                        <TextBlock
                                            Text="{Binding DurationInDays}"
                                            Opacity="0.7"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Price}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>


            <!-- ====================================== -->
            <!-- RIGHT SIDE -->
            <!-- ====================================== -->

            <Grid
                Grid.Column="1"
                Margin="12,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="1.8*"/>
                </Grid.RowDefinitions>


                <!-- ================================== -->
                <!-- INCLUDED MODULES -->
                <!-- ================================== -->

                <Border
                    Grid.Row="0"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Included Modules"
                            FontSize="20"
                            FontWeight="SemiBold"/>


                        <ListView
                            x:Name="ModulesListView"
                            Grid.Row="1"
                            Margin="0,12,0,0">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <CheckBox
                                        Content="{Binding ModuleName}"
                                        IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                        Margin="0,4"/>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>


                        <Button
                            Grid.Row="2"
                            Content="Save Modules"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="SaveModulesButton_Click"/>

                    </Grid>

                </Border>


                <!-- ================================== -->
                <!-- COMPANY SUBSCRIPTIONS -->
                <!-- ================================== -->

                <Border
                    Grid.Row="2"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Company Subscriptions"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <Button
                                Grid.Column="1"
                                Content="Add Subscription"
                                Click="AddSubscriptionButton_Click"/>

                        </Grid>


                        <!-- SUBSCRIPTIONS -->

                        <ListView
                            x:Name="CompanySubscriptionsListView"
                            Grid.Row="1"
                            Margin="0,12,0,0">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Grid Padding="8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- COMPANY + PLAN -->

                                        <StackPanel Grid.Column="0">

                                            <TextBlock
                                                Text="{Binding CompanyName}"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Text="{Binding PlanName}"
                                                Opacity="0.7"
                                                Margin="0,3,0,0"/>

                                        </StackPanel>


                                        <!-- STATUS -->

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            VerticalAlignment="Center"/>


                                        <!-- START DATE -->

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StartDateText}"
                                            VerticalAlignment="Center"/>


                                        <!-- END DATE -->

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding EndDateText}"
                                            VerticalAlignment="Center"/>

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Page>