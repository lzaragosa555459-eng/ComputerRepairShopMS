<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.ServiceManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ====================================== -->
            <!-- HEADER -->
            <!-- ====================================== -->

            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <TextBlock
                    Text="Service Management"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Register customers, devices, and service requests."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- ====================================== -->
            <!-- MAIN FORM -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="1"
                Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================== -->
                <!-- LEFT SIDE: FORM -->
                <!-- ================================== -->

                <ScrollViewer
                    Grid.Column="0"
                    Margin="0,0,24,0">

                    <StackPanel
                        Spacing="16">


                        <!-- ============================== -->
                        <!-- CUSTOMER INFORMATION -->
                        <!-- ============================== -->

                        <TextBlock
                            Text="Customer Information"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- First Name -->

                            <TextBox
                                x:Name="FirstNameBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="First Name"
                                Margin="0,0,8,12"/>


                            <!-- Middle Name -->

                            <TextBox
                                x:Name="MiddleNameBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Middle Name"
                                Margin="8,0,0,12"/>


                            <!-- Last Name -->

                            <TextBox
                                x:Name="LastNameBox"
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Last Name"
                                Margin="0,0,8,12"/>


                            <!-- Phone -->

                            <TextBox
                                x:Name="PhoneBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Phone"
                                Margin="8,0,0,12"/>


                            <!-- Email -->

                            <TextBox
                                x:Name="EmailBox"
                                Grid.Row="2"
                                Grid.Column="0"
                                Header="Email"
                                Margin="0,0,8,0"/>


                            <!-- Address -->

                            <TextBox
                                x:Name="AddressBox"
                                Grid.Row="2"
                                Grid.Column="1"
                                Header="Address"
                                Margin="8,0,0,0"/>

                        </Grid>


                        <!-- ============================== -->
                        <!-- DEVICE INFORMATION -->
                        <!-- ============================== -->

                        <TextBlock
                            Text="Device Information"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,12,0,0"/>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Device Type -->

                            <TextBox
                                x:Name="DeviceTypeBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Device Type"
                                Margin="0,0,8,12"/>


                            <!-- Brand -->

                            <TextBox
                                x:Name="BrandBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Brand"
                                Margin="8,0,0,12"/>


                            <!-- Model -->

                            <TextBox
                                x:Name="ModelBox"
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Model"
                                Margin="0,0,8,12"/>


                            <!-- Serial Number -->

                            <TextBox
                                x:Name="SerialNumberBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Header="Serial Number"
                                Margin="8,0,0,12"/>


                            <!-- Device Condition -->

                            <TextBox
                                x:Name="DeviceConditionBox"
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Header="Device Condition"
                                Margin="0,0,0,12"/>

                        </Grid>


                        <!-- ============================== -->
                        <!-- SERVICE REQUEST -->
                        <!-- ============================== -->

                        <TextBlock
                            Text="Service Request"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,12,0,0"/>


                        <!-- Description -->

                        <TextBox
                            x:Name="DescriptionBox"
                            Header="Description"
                            PlaceholderText="Describe the customer's reported problem..."
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="100"/>


                        <!-- Priority -->

                        <ComboBox
                            x:Name="PriorityBox"
                            Header="Priority"
                            SelectedIndex="1">

                            <ComboBoxItem
                                Content="Low"/>

                            <ComboBoxItem
                                Content="Medium"/>

                            <ComboBoxItem
                                Content="High"/>

                            <ComboBoxItem
                                Content="Urgent"/>

                        </ComboBox>


                        <!-- Status -->

                        <ComboBox
                            x:Name="StatusBox"
                            Header="Status"
                            SelectedIndex="0">

                            <ComboBoxItem
                                Content="Pending"/>

                            <ComboBoxItem
                                Content="Diagnosing"/>

                            <ComboBoxItem
                                Content="In Repair"/>

                            <ComboBoxItem
                                Content="Ready for Pickup"/>

                            <ComboBoxItem
                                Content="Completed"/>

                        </ComboBox>


                        <!-- ================================== -->
                        <!-- ACTION BUTTONS -->
                        <!-- ================================== -->

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="0,8,0,16">

                            <Button
                                x:Name="SubmitRequestButton"
                                Content="Submit Service Request"
                                Click="SubmitRequestButton_Click"/>

                            <Button
                                x:Name="ClearButton"
                                Content="Clear"
                                Click="ClearButton_Click"/>

                        </StackPanel>


                        <!-- STATUS -->

                        <InfoBar
                            x:Name="StatusBar"
                            IsOpen="False"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- ================================== -->
                <!-- RIGHT SIDE: CUSTOMERS -->
                <!-- ================================== -->

                <Border
                    Grid.Column="1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Customers"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Select an existing customer or register a new one using the form."
                            Opacity="0.7"/>


                        <ListView
                            x:Name="CustomerList"
                            SelectionChanged="CustomerList_SelectionChanged">

                            <ListView.Header>

                                <Grid Padding="8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="ID"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="First Name"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Last Name"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="Phone"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="Email"
                                        FontWeight="SemiBold"/>

                                </Grid>

                            </ListView.Header>


                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Grid Padding="8">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding CustomerId}"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding FirstName}"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding LastName}"/>

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Phone}"/>

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding Email}"/>
                                        

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>


                        </ListView>
                        
                        <TextBlock
                            Text="Customer Devices"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,20,0,0"/>

                        <ListView
                            x:Name="DeviceList"
                            SelectionMode="Single"
                            SelectionChanged="DeviceList_SelectionChanged">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Padding="8"
                                        Spacing="2">

                                        <TextBlock
                                            Text="{Binding DeviceType}"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            Text="{Binding Brand}"/>

                                        <TextBlock
                                            Text="{Binding Model}"/>

                                        <TextBlock
                                            Text="{Binding SerialNumber}"
                                            Opacity="0.7"/>

                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                        
                        <TextBlock
                            Text="Service Requests"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,20,0,0"/>

                        <ListView
                            x:Name="ServiceRequestList"
                            SelectionMode="Single">

                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel
                                        Padding="8"
                                        Spacing="4">

                                        <TextBlock
                                            Text="{Binding Description}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding Priority}"
                                            Opacity="0.8"/>

                                        <TextBlock
                                            Text="{Binding Status}"
                                            Opacity="0.8"/>

                                        <TextBlock
                                            Text="{Binding RequestDate}"
                                            Opacity="0.6"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>
    </ScrollViewer>

</Page>