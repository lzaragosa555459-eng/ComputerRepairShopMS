<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>

        <Border
            Width="420"
            Padding="32"
            CornerRadius="12"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel
                Spacing="16">

                <TextBlock
                    Text="Computer Repair System"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Sign in to your account"
                    Opacity="0.7"
                    HorizontalAlignment="Center"/>


                <TextBox
                    x:Name="UsernameTextBox"
                    Header="Username"/>


                <PasswordBox
                    x:Name="PasswordBox"
                    Header="Password"/>


                <TextBlock
                    x:Name="ErrorText"
                    Foreground="Red"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"/>


                <Button
                    x:Name="LoginButton"
                    Content="Login"
                    Click="LoginButton_Click"
                    HorizontalAlignment="Stretch"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>