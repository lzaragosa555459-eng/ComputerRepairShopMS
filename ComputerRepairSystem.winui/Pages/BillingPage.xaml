<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Billing"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Process payments for completed repairs."
                Opacity="0.7"/>

        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

            <ListView
                x:Name="BillingList">

                <ListView.Header>

                    <Grid Padding="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Customer"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Device"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Repair"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Status"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Action"
                            FontWeight="SemiBold"/>

                    </Grid>

                </ListView.Header>

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Grid Padding="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding CustomerName}"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding DeviceName}"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding RepairDescription}"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Completed"/>

                            <Button
                                Grid.Column="4"
                                Content="Pay"
                                Click="PayButton_Click"/>

                        </Grid>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>

    </Grid>

</Page>