<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="32"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <Image
                    Source="/Assets/AppIcon.ico"
                    Width="100"
                    Height="100"
                    Stretch="Uniform"/>

                <TextBlock
                    Text="Dashboard"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Overview of your repair shop."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- SUMMARY CARDS -->

            <Grid
                Grid.Row="1"
                ColumnSpacing="16"
                RowSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>


                <!-- CUSTOMERS -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="Customers"
                            FontSize="18"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="CustomersCountText"
                            Text="0"
                            FontSize="36"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>


                <!-- SERVICE REQUESTS -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="Service Requests"
                            FontSize="18"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="ServiceRequestsCountText"
                            Text="0"
                            FontSize="36"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>


                <!-- ACTIVE REPAIRS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="Active Repairs"
                            FontSize="18"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="ActiveRepairsCountText"
                            Text="0"
                            FontSize="36"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>


                <!-- COMPLETED REPAIRS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="10">

                        <TextBlock
                            Text="Completed Repairs"
                            FontSize="18"
                            Opacity="0.7"/>

                        <TextBlock
                            x:Name="CompletedRepairsCountText"
                            Text="0"
                            FontSize="36"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- REVENUE -->

            <Border
                Grid.Row="2"
                Padding="24"
                CornerRadius="12"
                BorderThickness="1">

                <StackPanel
                    Spacing="8">

                    <TextBlock
                        Text="Total Revenue"
                        FontSize="18"
                        Opacity="0.7"/>

                    <TextBlock
                        x:Name="TotalRevenueText"
                        Text="₱0.00"
                        FontSize="40"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>