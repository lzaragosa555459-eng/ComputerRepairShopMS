<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <!-- DASHBOARD COLORS -->

        <SolidColorBrush
            x:Key="CustomerBrush"
            Color="#00A8FF"/>

        <SolidColorBrush
            x:Key="RequestBrush"
            Color="#A855F7"/>

        <SolidColorBrush
            x:Key="RepairBrush"
            Color="#F59E0B"/>

        <SolidColorBrush
            x:Key="CompletedBrush"
            Color="#22C55E"/>

        <SolidColorBrush
            x:Key="RevenueBrush"
            Color="#3B82F6"/>

        <SolidColorBrush
            x:Key="CardBackgroundBrush"
            Color="#242424"/>

    </Page.Resources>


    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="32"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ====================================== -->
            <!-- HEADER -->
            <!-- ====================================== -->

            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <Image
                    Source="ms-appx:///Assets/LogoIT13CRS.png"
                    Width="80"
                    Height="80"
                    Stretch="Uniform"/>

                <TextBlock
                    x:Name="ShopNameText"
                    Text="Computer Repair Shop"
                    FontSize="20"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Dashboard"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Overview of your repair shop."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- ====================================== -->
            <!-- SUMMARY CARDS -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="1"
                ColumnSpacing="16"
                RowSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>


                <!-- ================================== -->
                <!-- CUSTOMERS -->
                <!-- ================================== -->


                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="24"
                    CornerRadius="12"
                    Background="#075985">

                    <StackPanel
                        Spacing="8">

                        <TextBlock
                            Text="Customers"
                            FontSize="18"
                            Foreground="White"
                            Opacity="0.85"/>

                        <TextBlock
                            x:Name="CustomersCountText"
                            Text="0"
                            FontSize="42"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </StackPanel>

                </Border>


                <!-- SERVICE REQUESTS -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="24"
                    CornerRadius="12"
                    Background="#6B21A8">

                    <StackPanel
                        Spacing="8">

                        <TextBlock
                            Text="Service Requests"
                            FontSize="18"
                            Foreground="White"
                            Opacity="0.85"/>

                        <TextBlock
                            x:Name="ServiceRequestsCountText"
                            Text="0"
                            FontSize="42"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </StackPanel>

                </Border>


                <!-- ACTIVE REPAIRS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="24"
                    CornerRadius="12"
                    Background="#B45309">

                    <StackPanel
                        Spacing="8">

                        <TextBlock
                            Text="Active Repairs"
                            FontSize="18"
                            Foreground="White"
                            Opacity="0.85"/>

                        <TextBlock
                            x:Name="ActiveRepairsCountText"
                            Text="0"
                            FontSize="42"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </StackPanel>

                </Border>


                <!-- COMPLETED REPAIRS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="24"
                    CornerRadius="12"
                    Background="#15803D">

                    <StackPanel
                        Spacing="8">

                        <TextBlock
                            Text="Completed Repairs"
                            FontSize="18"
                            Foreground="White"
                            Opacity="0.85"/>

                        <TextBlock
                            x:Name="CompletedRepairsCountText"
                            Text="0"
                            FontSize="42"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- TOTAL REVENUE -->
            <!-- ====================================== -->

            <Border
                Grid.Row="2"
                Padding="24"
                CornerRadius="12"
                Background="#1D4ED8">

                <StackPanel
                    Spacing="8">

                    <TextBlock
                        Text="Total Revenue"
                        FontSize="18"
                        Foreground="White"
                        Opacity="0.85"/>

                    <TextBlock
                        x:Name="TotalRevenueText"
                        Text="₱0.00"
                        FontSize="44"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>