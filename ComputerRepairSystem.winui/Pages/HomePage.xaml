<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <!-- ====================================== -->
        <!-- DASHBOARD BRUSHES -->
        <!-- ====================================== -->

        <SolidColorBrush
            x:Key="DashboardCardBrush"
            Color="#242424"/>

        <SolidColorBrush
            x:Key="DashboardBorderBrush"
            Color="#3A3A3A"/>

        <SolidColorBrush
            x:Key="AccentOrangeBrush"
            Color="#FF8A00"/>

        <SolidColorBrush
            x:Key="AccentBlueBrush"
            Color="#2563EB"/>

        <SolidColorBrush
            x:Key="AccentPurpleBrush"
            Color="#7C3AED"/>

        <SolidColorBrush
            x:Key="AccentGreenBrush"
            Color="#16A34A"/>

    </Page.Resources>


    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="28"
            RowSpacing="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ====================================== -->
            <!-- HEADER -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel
                    Spacing="4">

                    <TextBlock
                        Text="Dashboard"
                        FontSize="32"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="ShopNameText"
                        Text="Computer Repair Shop"
                        FontSize="15"
                        Opacity="0.7"/>

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="2">

                    <TextBlock
                        Text="Business Overview"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Current system data"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Opacity="0.6"/>

                </StackPanel>

            </Grid>


            <!-- ====================================== -->
            <!-- KPI CARDS -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="1"
                ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TOTAL REPAIRS -->

                <Border
                    Grid.Column="0"
                    Padding="20"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Spacing="8">

                            <TextBlock
                                Text="Total Repairs"
                                Opacity="0.75"/>

                            <TextBlock
                                x:Name="TotalRepairsCountText"
                                Text="0"
                                FontSize="34"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="All repair records"
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#29FF8A00">

                            <FontIcon
                                Glyph="&#xE90F;"
                                Foreground="{StaticResource AccentOrangeBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- PENDING REPAIRS -->

                <Border
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Spacing="8">

                            <TextBlock
                                Text="Pending Repairs"
                                Opacity="0.75"/>

                            <TextBlock
                                x:Name="PendingRepairsCountText"
                                Text="0"
                                FontSize="34"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Waiting to be handled"
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#297C3AED">

                            <FontIcon
                                Glyph="&#xE823;"
                                Foreground="{StaticResource AccentPurpleBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- COMPLETED REPAIRS -->

                <Border
                    Grid.Column="2"
                    Padding="20"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Spacing="8">

                            <TextBlock
                                Text="Completed Repairs"
                                Opacity="0.75"/>

                            <TextBlock
                                x:Name="CompletedRepairsCountText"
                                Text="0"
                                FontSize="34"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Successfully completed"
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#2916A34A">

                            <FontIcon
                                Glyph="&#xE73E;"
                                Foreground="{StaticResource AccentGreenBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- TOTAL REVENUE -->

                <Border
                    Grid.Column="3"
                    Padding="20"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Spacing="8">

                            <TextBlock
                                Text="Total Revenue"
                                Opacity="0.75"/>

                            <TextBlock
                                x:Name="TotalRevenueText"
                                Text="₱0.00"
                                FontSize="30"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Completed payments"
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="#292563EB">

                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="&#xEC59;"
                                Foreground="{StaticResource AccentBlueBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- MAIN DASHBOARD ROW -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================== -->
                <!-- REPAIR OVERVIEW -->
                <!-- ================================== -->

                <Border
                    Grid.Column="0"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>


                        <StackPanel
                            Grid.Row="0"
                            Spacing="3">

                            <TextBlock
                                Text="Repair Overview"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Repair activity over the last six months."
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <Grid
                            Grid.Row="1"
                            x:Name="RepairGraphContainer"
                            Margin="0,12,0,0"/>

                    </Grid>

                </Border>


                <!-- ================================== -->
                <!-- RECENT REPAIRS -->
                <!-- ================================== -->

                <Border
                    Grid.Column="1"
                    Padding="22"
                    CornerRadius="12"
                    Background="{StaticResource DashboardCardBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel
                            Grid.Row="0"
                            Spacing="3">

                            <TextBlock
                                Text="Recent Repairs"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Latest repair activity."
                                FontSize="12"
                                Opacity="0.6"/>

                        </StackPanel>


                        <ListView
                            Grid.Row="1"
                            x:Name="RecentRepairsListView"
                            Margin="0,12,0,0"
                            SelectionMode="None">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        Padding="6"
                                        Margin="0,2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel
                                            Spacing="3">

                                            <TextBlock
                                                Text="{Binding CustomerName}"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Text="{Binding DeviceName}"
                                                FontSize="12"
                                                Opacity="0.6"/>

                                        </StackPanel>


                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="3">

                                            <TextBlock
                                                Text="{Binding RepairNumber}"
                                                FontSize="12"
                                                HorizontalAlignment="Right"/>

                                            <TextBlock
                                                Text="{Binding Status}"
                                                FontSize="11"
                                                HorizontalAlignment="Right"
                                                Opacity="0.7"/>

                                        </StackPanel>

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- SECOND DASHBOARD ROW -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="3"
                ColumnSpacing="16"
                RowSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================== -->
                <!-- LEFT SIDE -->
                <!-- ================================== -->

                <StackPanel
                    Grid.Column="0"
                    Spacing="16">


                    <!-- REPAIR STATUS -->

                    <Border
                        Padding="22"
                        CornerRadius="12"
                        Background="{StaticResource DashboardCardBrush}"
                        BorderBrush="{StaticResource DashboardBorderBrush}"
                        BorderThickness="1">

                        <StackPanel
                            Spacing="14">

                            <StackPanel
                                Spacing="3">

                                <TextBlock
                                    Text="Repair Status"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Current repair workload."
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </StackPanel>


                            <!-- PENDING -->

                            <StackPanel
                                Spacing="6">

                                <Grid>

                                    <TextBlock
                                        Text="Pending"/>

                                    <TextBlock
                                        x:Name="PendingRepairsGraphText"
                                        Text="0"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <ProgressBar
                                    x:Name="PendingRepairsProgress"
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"/>

                            </StackPanel>


                            <!-- IN PROGRESS -->

                            <StackPanel
                                Spacing="6">

                                <Grid>

                                    <TextBlock
                                        Text="In Progress"/>

                                    <TextBlock
                                        x:Name="InProgressRepairsGraphText"
                                        Text="0"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <ProgressBar
                                    x:Name="InProgressRepairsProgress"
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"/>

                            </StackPanel>


                            <!-- COMPLETED -->

                            <StackPanel
                                Spacing="6">

                                <Grid>

                                    <TextBlock
                                        Text="Completed"/>

                                    <TextBlock
                                        x:Name="CompletedRepairsGraphText"
                                        Text="0"
                                        HorizontalAlignment="Right"/>

                                </Grid>

                                <ProgressBar
                                    x:Name="CompletedRepairsProgress"
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <!-- LOW STOCK -->

                    <Border
                        Padding="22"
                        CornerRadius="12"
                        Background="{StaticResource DashboardCardBrush}"
                        BorderBrush="{StaticResource DashboardBorderBrush}"
                        BorderThickness="1">

                        <StackPanel
                            Spacing="12">

                            <StackPanel
                                Spacing="3">

                                <TextBlock
                                    Text="Low Stock"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Items that need attention."
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </StackPanel>


                            <Grid>

                                <TextBlock
                                    x:Name="LowStockCountText"
                                    Text="0 items"
                                    FontSize="24"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Reorder recommended"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="11"
                                    Opacity="0.6"/>

                            </Grid>


                            <ListView
                                x:Name="LowStockListView"
                                MaxHeight="130"
                                SelectionMode="None"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- ================================== -->
                <!-- RIGHT SIDE -->
                <!-- ================================== -->

                <StackPanel
                    Grid.Column="1"
                    Spacing="16">


                    <!-- RECENT TRANSACTIONS -->

                    <Border
                        Padding="22"
                        CornerRadius="12"
                        Background="{StaticResource DashboardCardBrush}"
                        BorderBrush="{StaticResource DashboardBorderBrush}"
                        BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <StackPanel
                                Grid.Row="0"
                                Spacing="3">

                                <TextBlock
                                    Text="Recent Transactions"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Latest payment activity."
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </StackPanel>


                            <ListView
                                Grid.Row="1"
                                x:Name="RecentTransactionsListView"
                                Margin="0,10,0,0"
                                MaxHeight="190"
                                SelectionMode="None">

                                <ListView.ItemTemplate>

                                    <DataTemplate>

                                        <Grid
                                            Padding="6"
                                            Margin="0,2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <StackPanel
                                                Spacing="3">

                                                <TextBlock
                                                    Text="{Binding InvoiceNumber}"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Text="{Binding CustomerName}"
                                                    FontSize="12"
                                                    Opacity="0.6"/>

                                            </StackPanel>


                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding PaymentMethod}"
                                                FontSize="12"
                                                Margin="16,0"/>


                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding AmountText}"
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"/>

                                        </Grid>

                                    </DataTemplate>

                                </ListView.ItemTemplate>

                            </ListView>

                        </Grid>

                    </Border>


                    <!-- ================================== -->
                    <!-- OUTSTANDING PAYMENTS + ATTENDANCE -->
                    <!-- ================================== -->

                    <Grid
                        ColumnSpacing="16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- OUTSTANDING PAYMENTS -->

                        <Border
                            Grid.Column="0"
                            Padding="20"
                            CornerRadius="12"
                            Background="{StaticResource DashboardCardBrush}"
                            BorderBrush="{StaticResource DashboardBorderBrush}"
                            BorderThickness="1">

                            <StackPanel
                                Spacing="8">

                                <TextBlock
                                    Text="Outstanding Payments"
                                    FontSize="18"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="OutstandingPaymentsText"
                                    Text="₱0.00"
                                    FontSize="28"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="OutstandingInvoicesCountText"
                                    Text="0 invoices"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </StackPanel>

                        </Border>


                        <!-- TODAY'S ATTENDANCE -->

                        <Border
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="12"
                            Background="{StaticResource DashboardCardBrush}"
                            BorderBrush="{StaticResource DashboardBorderBrush}"
                            BorderThickness="1">

                            <StackPanel
                                Spacing="7">

                                <TextBlock
                                    Text="Today's Attendance"
                                    FontSize="18"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="PresentAttendanceText"
                                    Text="Present: 0"/>

                                <TextBlock
                                    x:Name="LateAttendanceText"
                                    Text="Late: 0"/>

                                <TextBlock
                                    x:Name="AbsentAttendanceText"
                                    Text="Absent: 0"/>

                                <TextBlock
                                    x:Name="LeaveAttendanceText"
                                    Text="Leave: 0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>