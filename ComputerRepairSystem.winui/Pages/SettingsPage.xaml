<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="32"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <TextBlock
                    Text="System Settings"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Manage basic shop information and labor rates."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- SETTINGS -->

            <StackPanel
                Grid.Row="1"
                Spacing="20"
                MaxWidth="700">


                <!-- SHOP INFORMATION -->

                <Border
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="16">

                        <TextBlock
                            Text="Shop Information"
                            FontSize="20"
                            FontWeight="SemiBold"/>


                        <TextBox
                            x:Name="ShopNameBox"
                            Header="Shop Name"
                            PlaceholderText="Enter shop name"/>


                        <TextBox
                            x:Name="ShopAddressBox"
                            Header="Shop Address"
                            PlaceholderText="Enter shop address"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="80"/>

                    </StackPanel>

                </Border>


                <!-- LABOR RATES -->

                <Border
                    Padding="24"
                    CornerRadius="12"
                    BorderThickness="1">

                    <StackPanel
                        Spacing="16">

                        <TextBlock
                            Text="Labor Rates"
                            FontSize="20"
                            FontWeight="SemiBold"/>


                        <NumberBox
                            x:Name="LowLaborRateBox"
                            Header="Low Priority"
                            Minimum="0"
                            SmallChange="50"/>


                        <NumberBox
                            x:Name="MediumLaborRateBox"
                            Header="Medium Priority"
                            Minimum="0"
                            SmallChange="50"/>


                        <NumberBox
                            x:Name="HighLaborRateBox"
                            Header="High Priority"
                            Minimum="0"
                            SmallChange="50"/>

                    </StackPanel>

                </Border>


                <!-- SAVE -->

                <Button
                    x:Name="SaveButton"
                    Content="Save Changes"
                    HorizontalAlignment="Left"
                    Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>