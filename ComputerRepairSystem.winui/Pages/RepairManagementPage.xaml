<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.RepairManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        Padding="32"
        RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ====================================== -->
        <!-- HEADER -->
        <!-- ====================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Repair Management"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Review and manage customer service requests."
                Opacity="0.7"/>

        </StackPanel>


        <!-- ====================================== -->
        <!-- SERVICE REQUEST TABLE -->
        <!-- ====================================== -->

        <Border
            Grid.Row="1"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

            <ListView
                x:Name="ServiceRequestList">

                <ListView.Header>

                    <Grid Padding="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="ID"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Customer"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Device"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Description"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Priority"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="Status"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="6"
                            Text="Action"
                            FontWeight="SemiBold"/>

                    </Grid>

                </ListView.Header>


                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Grid Padding="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>


                            <!-- REQUEST ID -->

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ServiceRequestId}"/>


                            <!-- CUSTOMER -->

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Device.Customer.FirstName}"/>


                            <!-- DEVICE -->

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Device.Model}"/>


                            <!-- DESCRIPTION -->

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding Description}"
                                TextWrapping="Wrap"/>


                            <!-- PRIORITY -->

                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding Priority}"/>


                            <!-- STATUS -->

                            <TextBlock
                                Grid.Column="5"
                                Text="{Binding Status}"/>


                            <!-- ACTION -->

                            <StackPanel
                                Grid.Column="6"
                                Orientation="Horizontal"
                                Spacing="6">

                                <Button
                                    Content="Diagnose"
                                    Click="DiagnoseButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>

        <TextBlock
            Grid.Row="2"
            Text="Repairs"
            FontSize="24"
            FontWeight="SemiBold"
            Margin="0,20,0,0"/>
        <Border
    Grid.Row="3"
    BorderThickness="1"
    CornerRadius="8"
    Padding="12">

            <ListView
        x:Name="RepairList">

                <ListView.Header>

                    <Grid Padding="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="ID"
                    FontWeight="SemiBold"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="Customer"
                    FontWeight="SemiBold"/>

                        <TextBlock
                    Grid.Column="2"
                    Text="Device"
                    FontWeight="SemiBold"/>

                        <TextBlock
                    Grid.Column="3"
                    Text="Diagnosis"
                    FontWeight="SemiBold"/>

                        <TextBlock
                    Grid.Column="4"
                    Text="Status"
                    FontWeight="SemiBold"/>

                        <TextBlock
                    Grid.Column="5"
                    Text="Action"
                    FontWeight="SemiBold"/>

                    </Grid>

                </ListView.Header>

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Grid Padding="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                        Grid.Column="0"
                        Text="{Binding RepairId}"/>

                            <TextBlock
                        Grid.Column="1"
                        Text="{Binding ServiceRequest.Device.Customer.FirstName}"/>

                            <TextBlock
                        Grid.Column="2"
                        Text="{Binding ServiceRequest.Device.Model}"/>

                            <TextBlock
                        Grid.Column="3"
                        Text="{Binding Diagnosis}"
                        TextWrapping="Wrap"/>

                            <TextBlock
                        Grid.Column="4"
                        Text="{Binding Status}"/>

                           <Button
                                Grid.Column="5"
                                Content="Open"
                                Click="OpenRepairButton_Click"/>

                        </Grid>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>

    </Grid>

</Page>